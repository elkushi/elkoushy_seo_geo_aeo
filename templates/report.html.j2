<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SEO · AEO · GEO report: {{ r.site }}</title>
<style>
:root{color-scheme:light dark;--bg:#f6f7f9;--card:#fff;--ink:#14171c;--muted:#5d6673;--line:#e3e6eb;--accent:#3b5bdb;
--high:#c2255c;--high-bg:#fdeef3;--med:#b35900;--med-bg:#fff4e6;--low:#3b5bdb;--low-bg:#edf2ff;--ok:#2b8a3e;--ok-bg:#ebfbee;--code:#f1f3f5;
--ring-high:#d6336c;--ring-med:#e67700;--ring-ok:#2b8a3e}
@media (prefers-color-scheme:dark){:root{--bg:#0f1115;--card:#171a21;--ink:#e8eaed;--muted:#a3abb6;--line:#2a2f39;--accent:#91a7ff;
--high:#f783ac;--high-bg:#2b1720;--med:#ffa94d;--med-bg:#2b2116;--low:#91a7ff;--low-bg:#1a2036;--ok:#69db7c;--ok-bg:#15261a;--code:#0b0d11;
--ring-high:#f06595;--ring-med:#ffa94d;--ring-ok:#69db7c}}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.55 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
.wrap{max-width:1040px;margin:0 auto;padding:32px 16px 64px}
a{color:var(--accent)}
h1{font-size:28px;margin:0 0 4px;letter-spacing:-.02em;overflow-wrap:anywhere}
h2{font-size:20px;margin:40px 0 14px;letter-spacing:-.01em}
h3{font-size:15px;margin:0}
.muted{color:var(--muted)}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:20px}
.card>:first-child{margin-top:0}.card>:last-child{margin-bottom:0}
/* long URLs, tokens and model output must never widen the page */
.body,.summary,table.kv td,blockquote,.meta,.q,.empty,.method{overflow-wrap:anywhere}
td{overflow-wrap:break-word}
.hero{display:flex;gap:28px;align-items:center;flex-wrap:wrap}
.hero .meta{flex:1;min-width:240px}
.eyebrow{font-size:13px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.ring{width:132px;height:132px;flex:none}
.ring text{font-weight:700;fill:var(--ink)}
.printbtn{margin-left:auto;align-self:flex-start;font:600 13px system-ui;padding:6px 12px;border-radius:8px;border:1px solid var(--line);background:var(--card);color:var(--ink);cursor:pointer}
.grid3{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;margin-top:14px}
.area .num{font-size:34px;font-weight:700;letter-spacing:-.03em}
.bar{height:8px;background:var(--line);border-radius:99px;overflow:hidden;margin:10px 0}
.bar i{display:block;height:100%;border-radius:99px}
.pills{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.pill{font-size:12px;font-weight:600;padding:3px 10px;border-radius:99px;white-space:nowrap}
.high{color:var(--high);background:var(--high-bg)}.medium{color:var(--med);background:var(--med-bg)}
.low{color:var(--low);background:var(--low-bg)}.ok{color:var(--ok);background:var(--ok-bg)}
.tag{font-size:11px;font-weight:700;padding:2px 8px;border-radius:6px;border:1px solid var(--line);color:var(--muted);white-space:nowrap}
.summary{font-size:16px}
.phase h2{display:flex;gap:10px;align-items:baseline;flex-wrap:wrap}
.phase h2 .count{font-size:13px;color:var(--muted);font-weight:500}
details.f{background:var(--card);border:1px solid var(--line);border-left-width:4px;border-radius:12px;margin-bottom:10px}
details.f.sev-high{border-left-color:var(--ring-high)}details.f.sev-medium{border-left-color:var(--ring-med)}details.f.sev-low{border-left-color:var(--low)}
details.f summary{cursor:pointer;list-style:none;padding:14px 40px 14px 16px;display:flex;gap:10px;align-items:center;flex-wrap:wrap;position:relative}
details.f summary::-webkit-details-marker{display:none}
details.f summary::after{content:"";position:absolute;right:18px;top:50%;width:8px;height:8px;margin-top:-6px;border:solid var(--muted);border-width:0 2px 2px 0;transform:rotate(45deg);transition:transform .15s}
details.f[open] summary::after{transform:rotate(-135deg);margin-top:-2px}
details.f summary:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:10px}
details.f summary h3{flex:1;min-width:200px;overflow-wrap:anywhere}
details.f summary .n{font-size:13px;white-space:nowrap}
details.f .body{padding:0 16px 16px}
.fix{background:var(--ok-bg);border-radius:10px;padding:10px 14px;margin:10px 0}
.fix b{color:var(--ok)}
.urls{font-size:13px;margin:8px 0 0;padding-left:18px;word-break:break-all}
.snip{margin:10px 0 0;border:1px solid var(--line);border-radius:10px;overflow:hidden;background:var(--code)}
.snip-h{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:6px 8px 6px 12px;border-bottom:1px solid var(--line);font-size:12px;color:var(--muted);font-weight:600}
.copy{font:600 12px system-ui;padding:4px 10px;border-radius:8px;border:1px solid var(--line);background:var(--card);color:var(--ink);cursor:pointer}
pre{margin:0;padding:12px;overflow:auto;font-size:12.5px;line-height:1.45;white-space:pre;max-height:420px}
table{width:100%;border-collapse:collapse;font-size:14px}
th,td{text-align:left;padding:8px 10px;border-bottom:1px solid var(--line);vertical-align:top}
tr:last-child>td{border-bottom:0}
th{font-size:12px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);font-weight:600}
.tablewrap{overflow-x:auto}
i.m{display:none;font-style:normal}
@media (max-width:640px){i.m{display:inline}}
.num-c{font-variant-numeric:tabular-nums}
table.kv td:first-child{width:210px}
.q{margin:10px 0 12px}
.q blockquote{margin:8px 0 0;padding:10px 14px;border-left:3px solid var(--line);color:var(--muted);font-size:13.5px;white-space:pre-wrap}
.passed{columns:2 280px;padding-left:0;list-style:none;margin:0}
.passed li{break-inside:avoid;padding:4px 0 4px 20px;position:relative}
.passed li::before{content:"✓";position:absolute;left:0;color:var(--ok);font-weight:700}
.empty{border-style:dashed}
.empty h3{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.empty p{margin:6px 0 0;color:var(--muted);font-size:14px}
.tip{margin-top:12px;padding:10px 14px;border-radius:10px;background:var(--low-bg);font-size:13.5px}
.tip b{color:var(--low)}
code.k{font:600 12.5px ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;background:var(--code);border:1px solid var(--line);border-radius:5px;padding:0 4px}
.method h3{margin:18px 0 6px;font-size:14px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)}
.method h3:first-child{margin-top:0}
.method ul{margin:0;padding-left:18px}
.method li{margin:4px 0}
.method .scope{margin:14px 0 0;font-size:13.5px;color:var(--muted)}
footer{margin-top:48px;font-size:13px;color:var(--muted)}

@media (max-width:640px){
  .wrap{padding-top:16px}
  h1{font-size:24px}
  h2{font-size:18px;margin-top:32px}
  .card{padding:16px}
  .hero{gap:16px}
  .ring{width:96px;height:96px}
  .hero .meta{min-width:0;flex-basis:100%}
  .printbtn{display:none}
  .grid3{gap:10px}
  .area .num{font-size:30px}
  details.f summary{padding:12px 36px 12px 12px;gap:8px}
  details.f summary h3{flex-basis:100%;min-width:0;order:3}
  details.f summary .n{order:2;margin-left:auto}
  details.f .body{padding:0 12px 14px}
  pre{white-space:pre-wrap;word-break:break-all;font-size:12px}
  /* stacked tables: one card per row, labels from data-label */
  table.stack thead{display:none}
  table.stack,table.stack tbody,table.stack tr,table.stack td{display:block;width:100%}
  table.stack tr{padding:10px 0;border-bottom:1px solid var(--line)}
  table.stack tr:last-child{border-bottom:0}
  table.stack tr:first-child,table.kv tr:first-child{padding-top:0}
  table.stack td{border:0;padding:2px 0;display:flex;gap:12px;justify-content:space-between;align-items:baseline}
  table.stack td::before{content:attr(data-label);font-size:12px;color:var(--muted);font-weight:600;flex:none}
  table.stack td.lead{font-size:15px;padding-bottom:4px}
  table.stack td.lead::before{display:none}
  table.stack td>span:not(.pill),table.stack td>b{text-align:right}
  table.bots tr{display:grid;grid-template-columns:1fr auto 74px;gap:4px 6px;align-items:center}
  table.bots td{display:block;padding:0}
  table.bots td::before{display:none}
  table.bots .c-name{grid-area:1/1/2/2;padding:0}
  table.bots .c-robots{grid-area:1/2/2/3}
  table.bots .c-live{grid-area:1/3/2/4}
  table.bots .c-live{text-align:right}
  table.bots .c-live.none{visibility:hidden}
  table.bots .c-use{grid-area:2/1/3/3;font-size:13.5px;color:var(--muted)}
  table.bots .c-use span{text-align:left}
  table.bots .c-type{grid-area:2/3/3/4;font-size:12px;text-align:right}
  table.kv tr{display:block;padding:8px 0;border-bottom:1px solid var(--line)}
  table.kv tr:last-child{border-bottom:0}
  table.kv td{display:block;border:0;padding:0}
  table.kv td.muted{font-size:12.5px;font-weight:600}
}

@media print{
  :root{color-scheme:light;--bg:#fff;--card:#fff;--ink:#111;--muted:#555;--line:#d0d4da;--accent:#1c3faa;
  --high:#a61e4d;--high-bg:#fdeef3;--med:#9c4a00;--med-bg:#fff4e6;--low:#2f4ac0;--low-bg:#edf2ff;--ok:#2b8a3e;--ok-bg:#ebfbee;--code:#f4f5f7;
  --ring-high:#d6336c;--ring-med:#e67700;--ring-ok:#2b8a3e}
  *{-webkit-print-color-adjust:exact;print-color-adjust:exact}
  body{font-size:12.5px;background:#fff}
  .wrap{max-width:none;padding:0 2px}
  .grid3{grid-template-columns:repeat(3,1fr)}
  .ring{width:110px;height:110px}
  .card,details.f,tr,.passed li{break-inside:avoid}
  h2{break-after:avoid;margin-top:24px}
  details.f summary::after,.copy,.printbtn,.tip,.tipref{display:none}
  pre{white-space:pre-wrap;word-break:break-all;max-height:none;overflow:visible}
  .tablewrap{overflow:visible}
  a{color:var(--ink);text-decoration:none}
}
</style>
</head>
<body>
{% set sevlabel = {"high":"High","medium":"Medium","low":"Low"} %}
{% set colfor = {"ok":"var(--ring-ok)","med":"var(--ring-med)","high":"var(--ring-high)"} %}
{% macro tone(s) -%}{{ "ok" if s>=75 else ("med" if s>=50 else "high") }}{%- endmacro %}
{% macro ring(score, label="") -%}
{% set c = 2*3.14159*52 %}
<svg class="ring" viewBox="0 0 132 132" role="img" aria-label="{{ label }} score {{ score }} out of 100">
  <circle cx="66" cy="66" r="52" fill="none" stroke="var(--line)" stroke-width="12"/>
  {% if score > 0 %}<circle cx="66" cy="66" r="52" fill="none" stroke="{{ colfor[tone(score)] }}" stroke-width="12" stroke-linecap="round"
    stroke-dasharray="{{ (c*score/100)|round(1) }} {{ c|round(1) }}" transform="rotate(-90 66 66)"/>{% endif %}
  <text x="66" y="72" text-anchor="middle" font-size="36">{{ score }}</text>
  <text x="66" y="93" text-anchor="middle" font-size="12" style="fill:var(--muted);font-weight:500">/ 100</text>
</svg>
{%- endmacro %}
{# Plain-language labels and enable tips for parts of the pipeline that did not run #}
{% set skipnames = {"pagespeed":"Core Web Vitals (Google Lighthouse)","visibility":"AI visibility test","seo":"SEO checks","aeo":"AEO checks","geo":"GEO checks"} %}
{% macro skip_reason(k, v) -%}
{%- set lv = (v or "")|lower -%}
{%- if lv == "disabled" -%}turned off for this run
{%- elif k == "pagespeed" and ("429" in lv or "quota" in lv) -%}Google's shared free PageSpeed quota was used up at the time of the audit
{%- elif k == "pagespeed" -%}Google PageSpeed did not return results ({{ v|truncate(90) }})
{%- elif k == "visibility" and "nvidia_api_key" in lv -%}no AI model was configured for this run
{%- elif k == "visibility" -%}the AI model did not return a usable answer ({{ v|truncate(90) }})
{%- else -%}{{ v|truncate(120) }}{%- endif -%}
{%- endmacro %}
{% macro skip_tip(k, v) -%}
{%- set lv = (v or "")|lower -%}
{%- if k == "pagespeed" -%}
  {%- if lv == "disabled" -%}Tick <b>Core Web Vitals</b> when starting the audit. For reliable results, add a free <code class="k">PAGESPEED_API_KEY</code> to <code class="k">.env</code>.
  {%- else -%}Add a free <code class="k">PAGESPEED_API_KEY</code> to <code class="k">.env</code> (Google Cloud Console → enable “PageSpeed Insights API” → Credentials → Create API key), restart the server and re-run the audit.{%- endif -%}
{%- elif k == "visibility" -%}
  {%- if "nvidia_api_key" in lv -%}Add <code class="k">NVIDIA_API_KEY</code> to <code class="k">.env</code> (free key from build.nvidia.com), restart the server and tick <b>AI visibility test</b>.
  {%- elif lv == "disabled" -%}Tick <b>AI visibility test</b> when starting the audit (needs <code class="k">NVIDIA_API_KEY</code> in <code class="k">.env</code>).
  {%- else -%}Re-run the audit; free-tier models are sometimes rate limited.{%- endif -%}
{%- endif -%}
{%- endmacro %}
{% macro empty_state(k, title, what) -%}
<div class="card empty">
  <h3>{{ title }} <span class="pill medium">not run</span></h3>
  <p>{{ what }} Not included in this audit: {{ skip_reason(k, r.skipped[k]) }}.</p>
  {% set t = skip_tip(k, r.skipped[k]) %}{% if t|trim %}<div class="tip"><b>How to include it:</b> {{ t }}</div>{% endif %}
</div>
{%- endmacro %}
{% set vis = r.metrics.visibility %}
{% set ps = r.metrics.pagespeed %}
{% set ps_ok = ps and ps.mobile and not ps.mobile.error %}
{% set bots = r.metrics.geo.ai_bots %}
{% set pages = r.metrics.seo.pages_crawled %}
<div class="wrap">

<header class="card hero">
  {{ ring(r.scores.overall, label="Overall") }}
  <div class="meta">
    <div class="eyebrow">SEO · AEO · GEO audit</div>
    <h1>{{ r.site }}</h1>
    <div class="muted"><a href="{{ r.url }}">{{ r.url }}</a> · {{ r.generated }} · grade {{ r.grades.overall }}</div>
    <div class="pills">
      <span class="pill high">{{ r.counts.high }} high</span>
      <span class="pill medium">{{ r.counts.medium }} medium</span>
      <span class="pill low">{{ r.counts.low }} low</span>
      <span class="pill ok">{{ r.passed|length }} passed</span>
    </div>
  </div>
  <button class="printbtn" type="button" onclick="window.print()">Print / PDF</button>
</header>

<div class="grid3">
{% for a in ["SEO","AEO","GEO"] %}
  {% set s = r.scores[a] %}{% set col = colfor[tone(s)] %}
  <div class="card area">
    <h3>{{ a }} <span class="muted" style="font-weight:500">· {{ r.area_info[a][0] }}</span></h3>
    <div class="num" style="color:{{ col }}">{{ s }}</div>
    <div class="bar"><i style="width:{{ s }}%;background:{{ col }}"></i></div>
    <div class="muted" style="font-size:13.5px">{{ r.area_info[a][1] }}</div>
    <div class="muted" style="font-size:13px;margin-top:8px">{{ r.findings|selectattr("area","equalto",a)|list|length }} issues · {{ r.passed|selectattr("area","equalto",a)|list|length }} passed</div>
  </div>
{% endfor %}
</div>

<h2>Executive summary</h2>
<div class="card summary">{{ r.summary }}</div>

{% for phase, items in r.roadmap.items() if items %}
<section class="phase">
  <h2>{{ phase }} <span class="count">{{ items|length }} item{{ "s" if items|length != 1 }}</span></h2>
  {% for f in items %}
  <details class="f sev-{{ f.severity }}"{% if loop.first and phase.startswith("Week") %} open{% endif %}>
    <summary>
      <span class="pill {{ f.severity }}">{{ sevlabel[f.severity] }}</span>
      <span class="tag">{{ f.area }}</span>
      <h3>{{ f.title }}</h3>
      {% if f.affected %}<span class="muted n">{{ f.affected }} URL{{ "s" if f.affected != 1 }}</span>{% endif %}
    </summary>
    <div class="body">
      <div>{{ f.detail }}</div>
      <div class="fix"><b>How to fix:</b> {{ f.fix }}</div>
      {% if f.snippet %}<div class="snip"><div class="snip-h"><span>Copy-paste fix</span><button class="copy" type="button">Copy</button></div><pre><code>{{ f.snippet }}</code></pre></div>{% endif %}
      {% if f.urls %}<ul class="urls">{% for u in f.urls %}<li><a href="{{ u }}">{{ u }}</a></li>{% endfor %}{% if f.affected > f.urls|length %}<li class="muted">+ {{ f.affected - f.urls|length }} more</li>{% endif %}</ul>{% endif %}
    </div>
  </details>
  {% endfor %}
</section>
{% endfor %}

<h2>AI visibility test</h2>
{% if vis and vis.runs %}
<div class="card vis">
  <p>We asked <b>{{ vis.model }}</b> the questions a potential customer would ask, without naming the brand, in two ways:
  from the model's own memory, and grounded on live web search results (the way Perplexity, ChatGPT search and AI Overviews work).</p>
  <div class="pills" style="margin-bottom:16px">
    <span class="pill {{ 'ok' if vis.brand_known else 'high' }}">Brand recognized: {{ "yes" if vis.brand_known else "no" }}</span>
    <span class="pill low">Mentioned from memory: {{ vis.recall_share }}</span>
    <span class="pill low">Mentioned / cited with search: {{ vis.search_share }}</span>
    {% if vis.profile.category %}<span class="pill low" style="white-space:normal">Category: {{ vis.profile.category }}</span>{% endif %}
  </div>
  <div class="q"><b>“What is {{ vis.brand }}?”</b><blockquote>{{ vis.brand_answer }}</blockquote></div>
  {% for run in vis.runs %}
  {% set hit_s = run.search_mentions or run.site_cited %}
  <details class="f sev-{{ 'low' if run.recall_mentions or hit_s else 'high' }}">
    <summary>
      <span class="pill {{ 'ok' if run.recall_mentions else 'high' }}">memory {{ "✓" if run.recall_mentions else "✗" }}</span>
      <span class="pill {{ 'ok' if hit_s else 'high' }}">search {{ "✓" if hit_s else "✗" }}</span>
      <h3>“{{ run.question }}”</h3>
    </summary>
    <div class="body">
      <div class="muted" style="font-size:13px">Site in top search results: {{ "yes" if run.site_in_results else "no" }}{% if run.competitors_mentioned %} · Competitors named: {{ run.competitors_mentioned|join(", ") }}{% endif %}</div>
      <div class="q"><b>Answer from memory</b><blockquote>{{ run.recall_answer }}</blockquote></div>
      {% if run.search_answer %}<div class="q"><b>Answer from search results</b><blockquote>{{ run.search_answer }}</blockquote></div>
      {% else %}<div class="q muted" style="font-size:13px">No web search results were available for this question.</div>{% endif %}
    </div>
  </details>
  {% endfor %}
</div>
{% elif "visibility" in r.skipped %}
{{ empty_state("visibility", "AI visibility test", "Checks whether an AI model mentions or cites the brand when a buyer asks category questions, from memory and with live web search.") }}
{% endif %}

{% if bots %}
<h2>AI crawler access</h2>
<div class="card tablewrap">
<p class="muted" style="font-size:13px;margin:0 0 10px"><b>robots.txt</b>: whether your rules let the bot in. <b>Live request</b>: the HTTP status your server returned when we fetched the homepage as that bot (200 = OK; tested for the main bots).</p>
<table class="stack bots">
  <thead><tr><th>Crawler</th><th>Used for</th><th>Type</th><th>robots.txt</th><th>Live request</th></tr></thead>
  <tbody>
  {% for b, v in bots.items() %}
  {% set live = r.metrics.geo.live_bot_status.get(b) %}
  <tr><td class="lead c-name"><b>{{ b }}</b></td><td class="c-use" data-label="Used for"><span>{{ v.product }}</span></td><td class="muted c-type" data-label="Type"><span>{{ v.purpose }}</span></td>
    <td class="c-robots" data-label="robots.txt"><span class="pill {{ 'ok' if v.allowed else ('high' if v.purpose=='search' else 'medium') }}">{{ "allowed" if v.allowed else "blocked" }}</span></td>
    <td class="c-live{{ ' none' if live is none }}" data-label="Live request">{% if live is not none %}<span class="pill {{ 'ok' if live == 200 else 'high' }}"><i class="m">HTTP </i>{{ live }}</span>{% else %}<span class="muted" title="Not requested">-</span>{% endif %}</td></tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% endif %}

<h2>Core Web Vitals (Google Lighthouse)</h2>
{% if ps_ok %}
<div class="card tablewrap">
<table class="stack">
  <thead><tr><th>Device</th><th>Performance</th><th>SEO</th><th>Accessibility</th><th>Best practices</th><th>LCP</th><th>CLS</th><th>TBT</th></tr></thead>
  <tbody>
  {% for k in ["mobile","desktop"] if ps[k] and not ps[k].error %}{% set m = ps[k] %}
  <tr><td class="lead"><b>{{ k|capitalize }}</b></td>
    {% for key, lab in [("performance","Performance"),("seo","SEO"),("accessibility","Accessibility"),("best-practices","Best practices")] %}
    {% set v = m[key] %}<td class="num-c" data-label="{{ lab }}">{% if v is not none %}<b style="color:{{ colfor[tone(v)] }}">{{ v }}</b>{% else %}<span class="muted">-</span>{% endif %}</td>
    {% endfor %}
    <td class="num-c" data-label="LCP"><span>{{ m.lcp_s if m.lcp_s is not none else "-" }} s</span></td>
    <td class="num-c" data-label="CLS"><span>{{ m.cls if m.cls is not none else "-" }}</span></td>
    <td class="num-c" data-label="TBT"><span>{{ m.tbt_ms|round|int if m.tbt_ms is not none else "-" }} ms</span></td></tr>
  {% endfor %}
  </tbody>
</table>
<p class="muted" style="font-size:13px;margin:12px 0 0">Lab data from a single Lighthouse run. Good thresholds: LCP ≤ 2.5 s, CLS ≤ 0.1, TBT ≤ 200 ms.</p>
</div>
{% elif "pagespeed" in r.skipped %}
{{ empty_state("pagespeed", "Core Web Vitals", "Measures loading speed and layout stability on mobile and desktop with Google Lighthouse; Google uses Core Web Vitals as a ranking signal.") }}
{% endif %}

{% set aeo = r.metrics.aeo %}
<h2>What we found on the site</h2>
<div class="card tablewrap">
<table class="kv">
  <tr><td class="muted">Pages analysed</td><td>{{ pages }}{% if r.metrics.seo.sitemap_urls %} ({{ r.metrics.seo.sitemap_urls }} URLs in sitemap){% endif %}</td></tr>
  <tr><td class="muted">Homepage title</td><td>{{ r.metrics.seo.home_title or "-" }}</td></tr>
  <tr><td class="muted">Homepage description</td><td>{{ r.metrics.seo.home_description or "-" }}</td></tr>
  <tr><td class="muted">Average words / page</td><td>{{ r.metrics.seo.avg_words }}</td></tr>
  <tr><td class="muted">Average response time</td><td>{{ r.metrics.seo.avg_response_ms }} ms</td></tr>
  <tr><td class="muted">Schema types</td><td>{{ aeo.schema_types_found|join(", ") or "none" }}</td></tr>
  <tr><td class="muted">Question headings</td><td>{{ aeo.question_headings }} ({{ aeo.answered_questions }} with a direct answer)</td></tr>
  <tr><td class="muted">Brand entity</td><td>{{ r.metrics.geo.brand }}{% if r.metrics.geo.wikidata %} · Wikidata: {% for e in r.metrics.geo.wikidata %}{{ e.id }} ({{ e.label }}){{ ", " if not loop.last }}{% endfor %}{% endif %}</td></tr>
</table>
</div>

{% if r.passed %}
<h2>Already in good shape</h2>
<div class="card"><ul class="passed">{% for p in r.passed %}<li><span class="tag">{{ p.area }}</span> {{ p.title }}</li>{% endfor %}</ul></div>
{% endif %}

<h2>Method</h2>
<div class="card method">
  <h3>What we checked</h3>
  <ul>
    <li><b>SEO:</b> crawled {% if pages > 1 %}the homepage plus {{ pages - 1 }} linked/sitemap page{{ "s" if pages - 1 != 1 }}{% else %}the homepage{% endif %}{% if r.metrics.seo.sitemap_urls and r.metrics.seo.sitemap_urls > pages %} (a sample of the {{ r.metrics.seo.sitemap_urls }} URLs in the sitemap){% endif %} and checked indexability, titles, descriptions, headings, canonicals, mobile tags, content depth, links, robots.txt and the XML sitemap{% if ps_ok %}, plus Google Lighthouse lab data for the homepage{% endif %}.</li>
    <li><b>AEO:</b> extracted all JSON-LD/microdata, checked schema coverage by page type, and measured question-style headings followed by direct answers, lists and tables.</li>
    <li><b>GEO:</b> tested {{ bots|length if bots else 14 }} AI crawler rules in robots.txt, made live requests with AI-bot user agents, and checked llms.txt, entity signals (sameAs, Wikidata, About page) and citability (authors, dates, statistics, sources){% if vis and vis.runs %}, then ran {{ vis.runs|length }} buyer question{{ "s" if vis.runs|length != 1 }} through {{ vis.model }} with and without web search{% endif %}.</li>
  </ul>
  <h3>How scores work</h3>
  <ul>
    <li>Each area starts at 100; every issue subtracts 15 (high), 7 (medium) or 3 (low), with a floor of 10. The overall score is the average of the three.</li>
    <li>Roadmap: <b>Week 1</b> = template/config changes with the biggest impact, <b>30 days</b> = remaining fixes, <b>90 days</b> = authority and content work.</li>
  </ul>
  {% if r.skipped %}
  <h3>Not included in this audit</h3>
  <ul>
    {% for k, v in r.skipped.items() %}<li><b>{{ skipnames.get(k, k) }}:</b> {{ skip_reason(k, v) }}.{% if k in ("pagespeed", "visibility") %} <span class="muted tipref">See the {{ skipnames[k] }} section above for how to include it.</span>{% endif %}</li>{% endfor %}
  </ul>
  {% endif %}
  <p class="scope">This is an outside-in audit of publicly reachable pages on {{ r.generated }}. It does not use Google Search Console, analytics, backlink or keyword-ranking data, so traffic, rankings and link authority are not assessed.</p>
</div>

<footer>Generated by the SEO · AEO · GEO Expert toolkit{% if r.llm_model %} · AI analysis by {{ r.llm_model }}{% endif %}.</footer>
</div>
<script>
document.querySelectorAll(".copy").forEach(b=>b.addEventListener("click",()=>{
  const t=b.closest(".snip").querySelector("pre").innerText;
  (navigator.clipboard?navigator.clipboard.writeText(t):Promise.reject()).then(()=>{b.textContent="Copied";setTimeout(()=>b.textContent="Copy",1500)}).catch(()=>{b.textContent="Select & copy"});
}));
// Print every finding expanded, then restore what the reader had open
let wasOpen=[];
addEventListener("beforeprint",()=>{wasOpen=[...document.querySelectorAll("details")].map(d=>d.open);document.querySelectorAll("details").forEach(d=>d.open=true)});
addEventListener("afterprint",()=>{document.querySelectorAll("details").forEach((d,i)=>d.open=wasOpen[i])});
</script>
</body>
</html>
