# Copy to .env and fill in. Keep variable names in sync with .env.
# Free-first: everything uncommented below is free (or has a free tier).

# --- Public web app (production, see DEPLOY.md) ---------------------------
# Full public URL of the app (used in magic-link emails; https => Secure cookie).
PUBLIC_URL=https://your-domain.com
# Bare domain Caddy requests the HTTPS certificate for (DNS A/AAAA must point to the server). Use localhost for a local test.
DOMAIN=your-domain.com
# Signs session cookies. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Login emails via Resend (resend.com, free tier 3,000 emails/month). Verify the sending domain there via its DNS records (SPF/DKIM).
# Empty = local dev mode: the login link is returned in the API response instead of emailed. Never leave empty in production.
RESEND_API_KEY=
# Sender shown in login emails; must be on the domain verified in Resend.
MAIL_FROM="SEO Audit <login@your-domain.com>"
# Reports per user per calendar month (admins are unlimited).
FREE_REPORTS_PER_MONTH=3
# Maximum pages crawled per report (keeps runs short and polite).
MAX_PAGES=25
# LLM features (AI visibility test, AI summary): 0 = off (launch default), 1 = on (needs NVIDIA_API_KEY).
ENABLE_AI=0
# Public page describing the crawler, linked from the crawler User-Agent (contact for site owners).
BOT_INFO_URL=https://your-domain.com/bot
# Comma-separated emails with unlimited reports, e.g. you@your-domain.com,partner@example.com
ADMIN_EMAILS=

# --- Google ---------------------------------------------------------------
# PageSpeed Insights / Core Web Vitals (free). Keyless calls share a global daily quota that is often exhausted.
# Create a key: Google Cloud console > APIs & Services > enable "PageSpeed Insights API" > Credentials > API key.
PAGESPEED_API_KEY=

# OAuth client for Search Console, Sheets, Slides (free).
# Google Cloud console > Credentials > OAuth client ID (Desktop app) > download as credentials.json in project root.
# token.json is created automatically on first login.
GOOGLE_CLIENT_SECRETS=credentials.json

# --- Bing -----------------------------------------------------------------
# Bing Webmaster Tools API (free). bing.com/webmasters > Settings > API access > API key.
BING_WEBMASTER_API_KEY=

# --- LLM visibility checks (GEO) - free tiers / local ---------------------
# Gemini API free tier: aistudio.google.com > Get API key.
GEMINI_API_KEY=
# Groq free tier (fast open models): console.groq.com > API Keys.
GROQ_API_KEY=
# Local models via Ollama (free, no key). Install from ollama.com, then e.g. `ollama pull llama3.1`.
OLLAMA_HOST=http://localhost:11434

# --- NVIDIA NIM - LLM for AI visibility check + summary (free tier) -------
# build.nvidia.com > pick a model > Get API Key. Free developer tier, rate limited.
# Without a key the AI visibility test is skipped and the summary is template-based.
NVIDIA_API_KEY=
# Optional model override (default: nvidia/nemotron-3.5-super-vl-120b-a12b).
# NVIDIA_MODEL=

# --- Optional / paid - NOT used by default --------------------------------
# Uncomment only if you explicitly decide to use a paid service.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# PERPLEXITY_API_KEY=
# FIRECRAWL_API_KEY=

# --- Deploy (GitHub Actions) ---------------------------------------------
# Prebuilt image from GHCR, used by docker compose on the server (DEPLOY.md 14b).
# APP_IMAGE=ghcr.io/YOUR_GITHUB_USER/seo-audit:latest

# Parallel analyses (each = crawler + headless Chromium for the PDF). Use 1 on 512 MB hosts such as Render Starter.
MAX_CONCURRENT_JOBS=2

# Postgres instead of the local SQLite file (needed on hosts without a persistent disk, e.g. Render Free).
# Neon free tier: console.neon.tech > project > Connection string (keep ?sslmode=require).
# DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
